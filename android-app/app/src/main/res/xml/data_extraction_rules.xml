<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31+): allowBackup="false" stops cloud backup but NOT
  device-to-device transfer, so exclude every data domain from both. The prefs
  hold the control token, effectively a remote-shell credential, and nothing
  else here is worth restoring: a new phone re-pairs by scanning the QR.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
